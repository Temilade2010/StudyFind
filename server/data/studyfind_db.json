      "replies": [
        {
          "id": "com_1_rep_1",
          "user_id": "usr_instructor_1",
          "user_name": "Dr. Evelyn Reed",
          "user_role": "instructor",
          "user_avatar": "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80",
          "content": "Great question Alex! Yes, if uncle is red, you only perform recoloring and propagate upwards. Rotation only triggers when uncle is black.",
          "created_at": "2026-02-15T16:45:00.000Z"
        }
      ]
    }
